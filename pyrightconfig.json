{
  "include": [
    "members",
    "manage2soar",
    "utils",
    "instructors"
  ],
  "exclude": [
    ".venv",
    "graphify-out",
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.*"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "standard",
  "reportAttributeAccessIssue": "none",
  "reportOptionalAttributeAccess": "none",
  "reportMissingDefaultExcludes": "none"
}
