#!/usr/bin/env python3
"""
Mailman-style header rewriter for Postfix (Content Filter)
Rewrites From header to list address and sets Reply-To to original sender
Uses X-Original-To header to find the original recipient before alias expansion
"""
import email
import fcntl
import os
import smtplib
import sys
from email.utils import formataddr, getaddresses, parseaddr

# List of mailing list addresses this server handles
# Format: set of lowercase email addresses
ADMIN_FORWARD_MARKER = '# --- Administrative forwarding aliases ---'
MAILING_LISTS = {
{% for club in club_domains %}
{% set explicit_domains = club.domains | default([]) %}
{% if explicit_domains is string %}
{% set explicit_domains = [explicit_domains] %}
{% endif %}
{% set tenant_domains = (explicit_domains if (club.use_explicit_domains_only | default(false)) and explicit_domains else [club.prefix ~ '.' ~ mail_domain] + explicit_domains) | unique %}
{% for domain in tenant_domains %}
    'members@{{ domain }}',
    'instructors@{{ domain }}',
    'towpilots@{{ domain }}',
    'directors@{{ domain }}',
    'board@{{ domain }}',
    'private-owners@{{ domain }}',
    'treasurer@{{ domain }}',
    'webmaster@{{ domain }}',
{% endfor %}
{% endfor %}
}


def _load_lists_from_virtual(virtual_file='/etc/postfix/virtual'):
    """
    Load all mailing list addresses from the Postfix virtual aliases file.
    This supplements the hardcoded MAILING_LISTS set with any lists dynamically
    configured via the app's MailingList model (e.g. 'operations-team@domain').
    """
    lists = set()
    try:
        with open(virtual_file, 'r') as f:
            for line in f:
                line = line.strip()
                if line == ADMIN_FORWARD_MARKER:
                    break
                if not line or line.startswith('#'):
                    continue
                parts = line.split(None, 1)
                if parts:
                    addr = parts[0].lower()
                    if '@' in addr:
                        lists.add(addr)
    except Exception as e:
        sys.stderr.write(
            f"maillist-rewriter: warning: could not read {virtual_file}: {e}\n"
        )
    return lists


def _load_forwarding_aliases_from_virtual(virtual_file='/etc/postfix/virtual'):
    """Load direct forwards separately from discussion lists."""
    aliases = set()
    try:
        with open(virtual_file, 'r') as f:
            content = f.read()
        if ADMIN_FORWARD_MARKER not in content:
            return aliases
        for line in content.split(ADMIN_FORWARD_MARKER, 1)[1].splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and '@' in parts[0]:
                aliases.add(parts[0].lower())
    except OSError as e:
        sys.stderr.write(f"maillist-rewriter: warning: could not read forwards: {e}\n")
    return aliases


def _load_routing_snapshot(virtual_file='/etc/postfix/virtual'):
    """Read list and forwarding routes from one consistent virtual-file snapshot."""
    lists = set()
    forwards = set()
    recipients = {}
    lock_fd = None
    try:
        # m2s-mail-sync publishes the source map and its Postfix database
        # while holding this lock. Taking a shared lock prevents this reader
        # from observing a source/database mixed generation.
        try:
            lock_fd = os.open(
                '/run/lock/m2s-mail-sync.lock', os.O_CREAT | os.O_RDWR, 0o644
            )
            fcntl.flock(lock_fd, fcntl.LOCK_SH)
        except OSError:
            lock_fd = None
        with open(virtual_file, 'r') as f:
            in_forwards = False
            for raw_line in f:
                line = raw_line.strip()
                if line == ADMIN_FORWARD_MARKER:
                    in_forwards = True
                    continue
                if not line or line.startswith('#'):
                    continue
                parts = line.split(None, 1)
                if len(parts) != 2 or '@' not in parts[0]:
                    continue
                address = parts[0].lower()
                recipients[address] = {
                    recipient.strip().lower()
                    for recipient in parts[1].split(',')
                    if recipient.strip()
                }
                (forwards if in_forwards else lists).add(address)
    except OSError as e:
        sys.stderr.write(f"maillist-rewriter: warning: could not read routes: {e}\n")
    finally:
        if lock_fd is not None:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)
    return lists, forwards, recipients


def _is_bounces_alias(addr):
    """Return True if ``addr`` is a list ``-bounces`` delivery alias.

    ``m2s-mail-sync`` writes a ``{list}-bounces@{domain} -> admin`` delivery
    alias into /etc/postfix/virtual for every mailing list.  These are
    *bounce delivery* aliases, NOT user-facing mailing lists, so they must
    never be treated as a detectable list by this rewriter.  If they were, an
    outbound email addressed to the bounces alias's delivery target (e.g. the
    club admin) would be false-positively detected as "list traffic" and its
    From header rewritten to a doubled ``{list}-bounces-bounces@...`` address
    (issue #1038).

    The input is normalized (falsey values, surrounding whitespace and case)
    so the check is robust regardless of how the address was sourced.
    """
    if not addr:
        return False
    local = addr.strip().lower().rsplit('@', 1)[0]
    return local.endswith('-bounces')


def _routing_sets(snapshot):
    """Build list/forward sets from one virtual-map snapshot."""
    virtual_lists, virtual_forwards, _ = snapshot
    forwarding_aliases = {
        addr for addr in virtual_forwards if not _is_bounces_alias(addr)
    }
    known_lists = {
        addr
        for addr in (MAILING_LISTS | virtual_lists)
        if not _is_bounces_alias(addr) and addr not in forwarding_aliases
    }
    return known_lists, forwarding_aliases


# Combine hardcoded list addresses with any dynamically-configured aliases.
# Dynamic lists are added by the app's MailingList model and written to
# /etc/postfix/virtual; we must include them here so they are not bounced.
# ``*-bounces@`` delivery aliases are excluded so they are never treated as a
# detectable mailing list (see _is_bounces_alias and issue #1038).
_VIRTUAL_LISTS, _VIRTUAL_FORWARDS, _ = _load_routing_snapshot()
ALL_KNOWN_LISTS, FORWARDING_ALIASES = _routing_sets(
    (_VIRTUAL_LISTS, _VIRTUAL_FORWARDS, {})
)


def rewrite_headers(msg, recipient, envelope_sender=None, allow_passthrough=False):
    """
    Rewrite headers Mailman-style:
    - Save original From to Reply-To
    - Rewrite From to list-bounces address with original name

    The automated sender ``noreply@<list_domain>`` is passed through unchanged
    only for authenticated/trusted submission traffic, so public port-25
    clients cannot spoof the application's sender (issue #846).

    The guard uses ``envelope_sender`` (the SMTP envelope sender from the
    ``MAIL FROM`` command as seen by Postfix) when available. This is preferred
    for the passthrough check because it is SMTP-session metadata rather than a
    message header, but it is still client-supplied and should not be treated as
    authenticated or unforgeable. It falls back to parsing the ``From`` header
    only when no envelope sender is provided (e.g. in unit tests).
    """
    # Determine the effective sender address for the passthrough guard.
    # Prefer the SMTP envelope sender because it comes from the SMTP session's
    # MAIL FROM command rather than the message headers/body. That makes it a
    # better signal than the From header for this heuristic, but it is still
    # client-provided SMTP metadata and not inherently trustworthy.
    guard_email = envelope_sender or parseaddr(msg.get('From', ''))[1]

    original_from = msg.get('From', '')
    original_name, original_email = parseaddr(original_from)

    # Get list address from recipient
    recipient_lower = recipient.lower()
    _, _, list_domain = recipient_lower.partition('@')

    # Only allow a narrow passthrough for the exact automated sender address
    # used by the application on trusted submission traffic. Public port-25
    # envelope senders are client-supplied and never qualify.
    if allow_passthrough and guard_email and guard_email.lower() == f"noreply@{list_domain}":
        return msg

    # Extract list name and domain (e.g., "webmaster" from "webmaster@domain.com")
    list_local, list_domain = recipient_lower.split('@', 1)
    list_name_display = list_local.replace('-', ' ').title()

    # Create Mailman-style bounces address (e.g., webmaster-bounces@domain.com)
    list_bounces_addr = f"{list_local}-bounces@{list_domain}"

    # Create new From with format: "Original Name via List Name" <list-bounces@domain.com>
    if original_name:
        new_from_name = f"{original_name} via {list_name_display}"
    else:
        new_from_name = f"{list_name_display} List"

    # Replace From header
    if 'From' in msg:
        del msg['From']
    msg['From'] = formataddr((new_from_name, list_bounces_addr))

    # Add Reply-To if not already present
    if not msg.get('Reply-To') and original_from:
        msg['Reply-To'] = original_from

    # Generate RFC 2369 headers from the actual list recipient.  Do not use a
    # generic members@ address: board@, instructors@, etc. must advertise
    # their own List-Post target.  Replace client-supplied values so an inbound
    # message cannot spoof a different list identity.
    for header in ('List-Id', 'List-Post', 'Precedence'):
        if header in msg:
            del msg[header]
    msg['List-Id'] = f"{list_name_display} <{list_local}.{list_domain}>"
    msg['List-Post'] = f"<mailto:{recipient_lower}>"
    msg['Precedence'] = 'list'

    return msg


def rewrite_forward_headers(msg, alias_address):
    """Make a direct forward acceptable to authenticated SMTP relays.

    Relays commonly reject an arbitrary external ``From`` domain. Keep the
    original sender available for replies and auditing, but use the verified
    club alias as the visible/envelope sender.
    """
    original_from = msg.get('From', '')
    original_reply_to = msg.get('Reply-To') or original_from
    original_name, _ = parseaddr(original_from)
    alias_local = alias_address.split('@', 1)[0]
    display_name = f"{original_name} via {alias_local}" if original_name else alias_local

    if original_from:
        msg['X-Original-From'] = original_from
    if 'From' in msg:
        del msg['From']
    msg['From'] = formataddr((display_name, alias_address))
    if 'Reply-To' in msg:
        del msg['Reply-To']
    if original_reply_to:
        msg['Reply-To'] = original_reply_to
    return msg


def find_list_from_recipients(
    recipients, preferred_domain=None, routing_snapshot=None, known_lists=None
):
    """
    Reverse-lookup: find which mailing list these recipients belong to
    by checking the virtual aliases file
    If preferred_domain is specified, prefer list addresses with that domain
    """
    try:
        if preferred_domain:
            preferred_domain = preferred_domain.lower()

        # Read the complete map once. The atomic publisher guarantees that
        # list addresses and their recipients come from the same generation.
        routing_snapshot = routing_snapshot or _load_routing_snapshot()
        _, _, routing_recipients = routing_snapshot
        if known_lists is None:
            known_lists, _ = _routing_sets(routing_snapshot)

        incoming_recipients = {
            r.strip().lower() for r in recipients if r and r.strip()
        }
        exact_matches = []
        subset_matches = []
        # Try each list address
        for list_addr in known_lists:
            alias_recipients = routing_recipients.get(list_addr, set())
            if not alias_recipients:
                continue
            # Prefer exact matches, but accept subset matches so
            # BCC+To-self works after virtual alias expansion.
            if incoming_recipients == alias_recipients:
                exact_matches.append((list_addr, len(alias_recipients)))
                continue
            if alias_recipients.issubset(incoming_recipients):
                # Tighten subset matching to reduce false positives:
                # only allow when a preferred domain exists, list
                # domain matches that preference, and extras are small.
                if not preferred_domain or not list_addr.endswith('@' + preferred_domain):
                    continue
                extra_recipient_count = len(incoming_recipients - alias_recipients)
                if extra_recipient_count <= 2:
                    subset_matches.append((list_addr, len(alias_recipients)))

        matches = exact_matches if exact_matches else subset_matches

        if not matches:
            return None

        # Deterministic best-match selection:
        # 1) preferred domain when provided
        # 2) largest alias recipient set (most specific)
        # 3) shortest alias (prefer the canonical name over a suffixed alias)
        # 4) stable lexical address tie-break
        if preferred_domain:
            domain_matches = [m for m in matches if m[0].endswith('@' + preferred_domain)]
            if domain_matches:
                matches = domain_matches

        best = sorted(matches, key=lambda item: (-item[1], len(item[0]), item[0]))[0]
        return best[0]
    except Exception as e:
        sys.stderr.write(f"maillist-rewriter: error reading /etc/postfix/virtual in find_list_from_recipients: {e}\n")


def detect_original_recipient(
    msg, recipients, trusted_original_recipient=None, routing_snapshot=None
):
    """
    Identify the original recipient in priority order.

    Direct forwarding aliases and mailing lists are deliberately returned as
    separate routing classes.  X-Original-To is authoritative because the
    content filter may receive recipients after virtual-alias expansion.
    """
    original_to = None
    supplied_snapshot = routing_snapshot is not None
    routing_snapshot = routing_snapshot or _load_routing_snapshot()
    if supplied_snapshot:
        known_lists, forwarding_aliases = _routing_sets(routing_snapshot)
    else:
        # Preserve the compatibility behavior of this helper for callers that
        # override the module-level route sets.  main() passes an explicit
        # snapshot, so deployed routing decisions remain generation-consistent.
        known_lists, forwarding_aliases = ALL_KNOWN_LISTS, FORWARDING_ALIASES

    # This value is supplied by Postfix's ${original_recipient} expansion,
    # before virtual alias expansion. Never use a client-provided header for
    # routing when trusted delivery metadata is available.
    if trusted_original_recipient is not None:
        trusted = trusted_original_recipient.strip().lower()
        resolved = resolve_alias_recipient(trusted, known_lists, forwarding_aliases)
        if resolved:
            return resolved
        # Postfix supplied metadata is authoritative. Do not fall back to
        # message headers when it is present but not a configured route.
        return None

    # Try To header first (most reliable for content filters).
    # Use getaddresses() so multi-address To headers are parsed correctly.
    to_addresses = getaddresses(msg.get_all('To', []))
    for _, to_addr in to_addresses:
        if to_addr and to_addr.lower() in known_lists:
            original_to = to_addr.lower()
            break

    # Check Cc headers for reply-all workflows.
    if not original_to:
        for _, cc_addr in getaddresses(msg.get_all('Cc', []) + msg.get_all('CC', [])):
            if cc_addr and cc_addr.lower() in known_lists:
                original_to = cc_addr.lower()
                break

    # A direct forward may share the dev-mode destination with every list.
    # Detect it by the original To/Cc address before reverse-lookup would
    # incorrectly classify it as one of those lists.
    if not original_to:
        for _, addr in to_addresses + getaddresses(msg.get_all('Cc', []) + msg.get_all('CC', [])):
            if addr and addr.lower() in forwarding_aliases:
                return addr.lower()

    # Extract preferred domain from To/CC header for reverse-lookup fallback
    preferred_domain = None
    if original_to and '@' in original_to:
        preferred_domain = original_to.split('@')[1]
    elif to_addresses:
        first_to_addr = to_addresses[0][1]
        if first_to_addr and '@' in first_to_addr:
            preferred_domain = first_to_addr.split('@')[1].lower()

    # Envelope recipients catch direct BCC where the original address is
    # still present. Prefer an explicit list, then a direct alias.
    if not original_to:
        for recipient in recipients:
            if recipient.lower() in known_lists:
                original_to = recipient.lower()
                break

    if not original_to:
        for recipient in recipients:
            if recipient.lower() in forwarding_aliases:
                return recipient.lower()

    if not original_to:
        # Bounces should be delivered as-is, not mistaken for a list just
        # because their destination matches one of the dev-mode recipients.
        for _, addr in to_addresses + getaddresses(msg.get_all('Cc', [])):
            if addr and _is_bounces_alias(addr):
                return None
        # Fallback supports post-expansion recipients via subset matching.
        lookup_lists = known_lists
        if not supplied_snapshot:
            lookup_lists, _ = _routing_sets(routing_snapshot)
        original_to = find_list_from_recipients(
            recipients,
            preferred_domain,
            routing_snapshot=routing_snapshot,
            known_lists=lookup_lists,
        )

    return original_to


def resolve_alias_recipient(
    address, known_lists=None, forwarding_aliases=None
):
    """Resolve Postfix's recipient-delimiter extension to a known address."""
    known_lists = ALL_KNOWN_LISTS if known_lists is None else known_lists
    forwarding_aliases = (
        FORWARDING_ALIASES if forwarding_aliases is None else forwarding_aliases
    )
    address = address.strip().lower()
    if address in known_lists or address in forwarding_aliases:
        return address
    if '@' not in address:
        return None
    local, domain = address.rsplit('@', 1)
    if '+' not in local:
        return None
    base = f"{local.split('+', 1)[0]}@{domain}"
    if base in known_lists or base in forwarding_aliases:
        return base
    return None


# Kept as a compatibility name for local integrations and older tests.
detect_original_list = detect_original_recipient


def routing_class(recipient, known_lists=None, forwarding_aliases=None):
    """Return ``mailing_list``, ``forwarding_alias``, or ``None``."""
    known_lists = ALL_KNOWN_LISTS if known_lists is None else known_lists
    forwarding_aliases = (
        FORWARDING_ALIASES if forwarding_aliases is None else forwarding_aliases
    )
    if not recipient:
        return None
    normalized = recipient.lower()
    if normalized in forwarding_aliases:
        return "forwarding_alias"
    if normalized in known_lists:
        return "mailing_list"
    return None


def main():
    """
    Content filter: Read email from stdin, rewrite headers, reinject to port 10025
    Args: nexthop sender original_recipient recipient... traffic_class
    """
    if len(sys.argv) < 6:
        sys.stderr.write("Usage: maillist-rewriter.py nexthop sender original_recipient recipient... [public|trusted]\n")
        sys.exit(1)

    nexthop = sys.argv[1]
    sender = sys.argv[2]
    trusted_original_recipient = sys.argv[3]
    recipients = sys.argv[4:]
    traffic_class = recipients.pop()
    allow_passthrough = traffic_class == 'trusted'
    if traffic_class not in {'public', 'trusted'} or not recipients:
        sys.stderr.write("maillist-rewriter: invalid traffic class or recipient list\n")
        sys.exit(1)

    # Read message from stdin
    original_msg = sys.stdin.buffer.read()
    msg = email.message_from_bytes(original_msg)
    routing_snapshot = _load_routing_snapshot()
    known_lists, forwarding_aliases = _routing_sets(routing_snapshot)

    original_to = detect_original_recipient(
        msg,
        recipients,
        trusted_original_recipient=trusted_original_recipient,
        routing_snapshot=routing_snapshot,
    )

    # If list detection failed entirely, this is a transactional email (e.g. password
    # reset, notification) — not a mailing list message.  Pass it through to the
    # reinject port without any header rewriting.  No From-rewrite is needed because
    # the envelope sender domain is already the verified manage2soar.com address.
    if not original_to:
        sys.stderr.write(
            f"maillist-rewriter: Could not identify mailing list for "
            f"recipients {recipients}; passing through without header rewriting "
            "(transactional email — not a mailing list message).\n"
        )
        try:
            smtp = smtplib.SMTP('127.0.0.1', 10025)
            smtp.sendmail(sender, recipients, original_msg)
            smtp.quit()
            sys.exit(0)
        except smtplib.SMTPException as e:
            sys.stderr.write(f"maillist-rewriter: SMTP passthrough failed: {e}\n")
            sys.exit(os.EX_TEMPFAIL)

    # Rewrite mailing-list recipients and normalize direct forwards to a
    # verified club sender accepted by authenticated SMTP relays.
    route = routing_class(original_to, known_lists, forwarding_aliases)
    is_mailing_list = route == "mailing_list"
    is_forwarding_alias = route == "forwarding_alias"
    if is_mailing_list:
        # Pass the SMTP envelope sender so the passthrough guard uses a
        # Postfix-verified address instead of the (spoofable) From header.
        msg = rewrite_headers(
            msg,
            original_to,
            envelope_sender=sender,
            allow_passthrough=allow_passthrough,
        )
    elif is_forwarding_alias:
        msg = rewrite_forward_headers(msg, original_to)

    # Reinject to port 10025 (bypasses content_filter)
    # CRITICAL: Use rewritten From header as envelope sender for SMTP2Go verification
    # SMTP2Go checks both envelope sender AND From header domain
    try:
        smtp = smtplib.SMTP('127.0.0.1', 10025)
        # Mailing-list and direct-forward reinjection use verified club
        # addresses. Unknown recipients retain the original envelope sender.
        envelope_sender = sender
        if (is_mailing_list or is_forwarding_alias) and sender:
            from_header = msg.get("From", "")
            _, envelope_sender = parseaddr(from_header)
            if is_forwarding_alias:
                # Do not return delivery failures to the forward itself.
                alias_local, alias_domain = original_to.split('@', 1)
                envelope_sender = f"{alias_local}-bounces@{alias_domain}"
        # Ensure we never use an empty envelope sender; prefer verified mailing list addresses
        if not envelope_sender:
            sys.stderr.write("maillist-rewriter: Warning: Rewritten From header is empty or unparsable; this indicates a potential bug in rewrite_headers. Falling back to a verified mailing list envelope sender.\n")
            # Preserve the null reverse path for DSNs; it must never be
            # replaced with an alias, or delivery failures can loop forever.
            if not sender:
                envelope_sender = ''
                smtp.sendmail(envelope_sender, recipients, msg.as_bytes())
                smtp.quit()
                sys.exit(0)
            fallback_sender = None
            # Prefer the detected original mailing list recipient if it is known
            if original_to and original_to.lower() in MAILING_LISTS:
                fallback_sender = original_to.lower()
            # Otherwise, choose a stable fallback address by sorting the configured mailing lists.
            # Note: MAILING_LISTS is an unordered set; determinism comes from explicitly sorting
            # the set contents here, not from any inherent ordering of the set itself.
            elif MAILING_LISTS:
                fallback_sender = sorted(MAILING_LISTS)[0]
            # Absolute last-resort: local postmaster
            if not fallback_sender:
                fallback_sender = "postmaster@localhost"
            # Final safety check: ensure fallback_sender is a non-empty, syntactically valid email-like string
            if not isinstance(fallback_sender, str) or not fallback_sender or "@" not in fallback_sender:
                sys.stderr.write("maillist-rewriter: Error: fallback envelope sender is invalid; using postmaster@localhost as last resort.\n")
                fallback_sender = "postmaster@localhost"
            envelope_sender = fallback_sender
        smtp.sendmail(envelope_sender, recipients, msg.as_bytes())
        smtp.quit()
        sys.exit(0)
    except smtplib.SMTPException as e:
        # More specific logging for SMTP-related failures (including connection issues)
        sys.stderr.write(f"SMTP reinject failed: {e}\n")
        sys.exit(os.EX_TEMPFAIL)
    except Exception as e:
        # Fallback for any non-SMTP unexpected errors
        sys.stderr.write(f"Reinject failed (unexpected error): {e}\n")
        sys.exit(os.EX_TEMPFAIL)

if __name__ == '__main__':
    main()
