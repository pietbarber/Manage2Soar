# ============================================================
# Postfix main.cf - Generated by Ansible
# ============================================================
# DO NOT EDIT MANUALLY - changes will be overwritten
# Managed by: infrastructure/ansible/roles/postfix/

# Basic settings
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

# Hostname and domain
myhostname = {{ mail_hostname }}
mydomain = {{ mail_domain }}
myorigin = $mydomain

# Network settings
inet_interfaces = all
inet_protocols = ipv4
mydestination = $myhostname, localhost.$mydomain, localhost

# Trusted networks (for relaying)
# WARNING: Be careful with broad CIDR ranges (e.g., /16 or larger).
# Only include IPs that should be trusted to send mail through this server.
# Each trusted IP can send mail without SASL authentication.
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128 {{ trusted_relay_ips | join(' ') }}

# Mailbox settings (we don't store mail locally)
mailbox_size_limit = 0
recipient_delimiter = +

# Add X-Original-To header before alias expansion (for content filter)
always_add_missing_headers = yes
maillist-rewriter_destination_recipient_limit = 1

# ============================================================
# VIRTUAL DOMAINS AND ALIASES
# ============================================================
# This is the key to mailing list functionality

# List of domains we handle mail for
virtual_alias_domains = hash:{{ postfix_config_dir }}/virtual_domains

# Alias mappings (members@ -> list of recipients)
virtual_alias_maps = hash:{{ postfix_config_dir }}/virtual

# ============================================================
# TLS SETTINGS
# ============================================================
# Enable TLS for both sending and receiving
# Uses self-signed certificates (Let's Encrypt deferred - see docs/iac-backfill-golive-2026-01-19.md)

# Incoming TLS
smtpd_tls_cert_file = /etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file = /etc/ssl/private/ssl-cert-snakeoil.key
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1

# Outgoing TLS (configured in relay section below)
smtp_tls_loglevel = 1

# ============================================================
# SASL AUTHENTICATION (for M2S to send)
# ============================================================
smtpd_sasl_auth_enable = yes
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $mydomain
broken_sasl_auth_clients = yes

# ============================================================
# SMTP RESTRICTIONS (Issue #533 - Mail Spam Protection)
# ============================================================

# Restriction classes (reusable tenant-scoped authorization rules)
# Each recipient access entry selects the whitelist for that recipient's tenant.
{% set restriction_classes = namespace(values=[]) %}
{% for club in club_domains %}
{% set restriction_classes.values = restriction_classes.values + ['whitelist_required_' ~ (club.prefix | replace('-', '_'))] %}
{% endfor %}
smtpd_restriction_classes = {{ restriction_classes.values | join(', ') }}
{% for club in club_domains %}
whitelist_required_{{ club.prefix | replace('-', '_') }} = check_sender_access hash:{{ postfix_whitelist_dir }}/{{ club.prefix }}_whitelist, reject
{% endfor %}

# Who can connect
smtpd_client_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unknown_client_hostname

# Who can send HELO/EHLO
smtpd_helo_required = yes
smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname

# Who can send mail (envelope sender)
smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unknown_sender_domain,
    reject_non_fqdn_sender

# Who can receive mail (envelope recipient)
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    check_recipient_access hash:{{ postfix_config_dir }}/recipient_whitelist_check,
    reject_unauth_destination,
    reject_unknown_recipient_domain,
    reject_non_fqdn_recipient

# Relay restrictions
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    defer_unauth_destination

# ============================================================
# MILTERS (OpenDKIM + Rspamd)
# ============================================================
# OpenDKIM: verifies DKIM on incoming, signs outgoing
# Rspamd: scans incoming mail for spam (rejects during SMTP)
#
# Order matters: OpenDKIM first so Rspamd can use DKIM/SPF results for scoring
# tempfail = defer mail if milter unavailable (security: don't skip spam checks)
#
# NOTE: OpenDKIM socket is at /var/spool/postfix/opendkim/opendkim.sock (inside Postfix chroot)
milter_default_action = tempfail
milter_protocol = 6
{% if postfix_rspamd_enabled | default(true) | bool %}
smtpd_milters = unix:/opendkim/opendkim.sock, inet:127.0.0.1:11332
{% else %}
smtpd_milters = unix:/opendkim/opendkim.sock
{% endif %}
# Only OpenDKIM for non-SMTP mail (sendmail, pickup queue).
non_smtpd_milters = unix:/opendkim/opendkim.sock

# ============================================================
# OUTBOUND RELAY (SMTP2GO)
# ============================================================
# GCP blocks outbound port 25, so we relay through SMTP2GO
{% if smtp_relay_host is defined and smtp_relay_host %}
relayhost = [{{ smtp_relay_host }}]:{{ smtp_relay_port | default(587) }}
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_tls_security_level = encrypt
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
{% endif %}

# ============================================================
# PERFORMANCE TUNING
# ============================================================
default_process_limit = 100
smtpd_client_connection_count_limit = 10
smtpd_client_connection_rate_limit = 30

# ============================================================
# HEADER REWRITING (Mailing Lists)
# ============================================================
# From header rewriting runs on both public SMTP and trusted submission.
# Public SMTP is always rewritten for list traffic; only the trusted
# submission transport may preserve the exact automated noreply sender.

# List-specific RFC 2369 headers are generated by maillist-rewriter.py.
# Keep the smtp header-check hook available for future non-routing checks.
smtp_header_checks = pcre:{{ postfix_config_dir }}/smtp_header_checks

# The content-filter script accepts one original recipient per invocation.
# Prevent Postfix from batching different aliases into one command.
maillist-rewriter-inbound_destination_recipient_limit = 1
maillist-rewriter-submission_destination_recipient_limit = 1
