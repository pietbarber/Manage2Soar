#!/usr/bin/env python3
"""
M2S Mail Alias Sync Script - Generated by Ansible
==================================================
Fetches mailing list membership from M2S API and updates Postfix virtual aliases.

This script is run by cron every minute.
"""

import grp
import fcntl
import hashlib
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from urllib.parse import urlsplit

import requests
import yaml

MAP_LOCK_FILE = '/run/lock/m2s-mail-map.lock'


def load_config():
    """Load configuration from YAML file."""
    config_path = os.path.join(os.path.dirname(__file__), 'config.yml')
    with open(config_path, 'r') as f:
        return yaml.safe_load(f)

# Email validation pattern (RFC 5322 simplified, stricter: no leading/trailing dots)
# Single-char local parts are allowed (e.g., a@domain.com)
EMAIL_PATTERN = re.compile(r'^[a-zA-Z0-9]([a-zA-Z0-9._%+-]*[a-zA-Z0-9+-])?@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\.[a-zA-Z]{2,}$')
LOCAL_PART_PATTERN = re.compile(r'^[a-z0-9](?:[a-z0-9._-]*[a-z0-9-])?$')
TENANT_PREFIX_PATTERN = re.compile(r'^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$')
DNS_NAME_PATTERN = re.compile(
    r'^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?'
    r'(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)+$'
)


def is_valid_email(email):
    """Validate email format and check for injection characters.

    This prevents malicious recipients from injecting newlines, comments,
    or other control characters into the Postfix virtual alias file.
    """
    if not email or not isinstance(email, str):
        return False
    # Check for injection characters
    if any(c in email for c in '\n\r\t# '):
        return False
    return bool(EMAIL_PATTERN.match(email))


def is_valid_alias_name(name):
    """Validate a Postfix alias local part using the Django model rules."""
    if not isinstance(name, str) or name != name.lower():
        return False
    if '..' in name or '+' in name or name.endswith('.') or name.endswith('-bounces'):
        return False
    return bool(LOCAL_PART_PATTERN.fullmatch(name))


def is_valid_dns_name(name):
    """Validate a configured mail domain before using it in generated files."""
    return isinstance(name, str) and bool(DNS_NAME_PATTERN.fullmatch(name))


def is_safe_api_url(value):
    """Require HTTPS except for explicitly local development endpoints."""
    if not isinstance(value, str):
        return False
    parsed = urlsplit(value)
    if parsed.scheme == 'https' and parsed.hostname:
        return True
    return (
        parsed.scheme == 'http'
        and parsed.hostname in {'localhost', '127.0.0.1', '::1'}
    )


def validate_club_response(data):
    """Validate the API shape before it can influence any generated map."""
    if not isinstance(data, dict):
        raise ValueError('API response must be a JSON object')

    lists = data.get('lists')
    if not isinstance(lists, dict):
        raise ValueError('API response lists must be an object')
    for list_name, recipients in lists.items():
        if not isinstance(list_name, str) or not isinstance(recipients, list):
            raise ValueError('API response list names and recipients are invalid')
        if any(not isinstance(recipient, str) for recipient in recipients):
            raise ValueError(f'API response contains a non-string recipient in {list_name!r}')

    for field in ('whitelist', 'bypass_lists'):
        values = data.get(field, [])
        if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
            raise ValueError(f'API response {field} must be a list of strings')

    forwarding_aliases = data.get('forwarding_aliases', {})
    if (
        not isinstance(forwarding_aliases, dict)
        or any(
            not isinstance(name, str) or not isinstance(destination, str)
            for name, destination in forwarding_aliases.items()
        )
    ):
        raise ValueError('API response forwarding_aliases must be a string map')


def postfix_restriction_class(prefix):
    """Return the safe Postfix restriction-class name for a tenant."""
    return f"whitelist_required_{prefix.replace('-', '_')}"


def validate_configuration(config):
    """Reject unsafe deployment configuration before making API requests."""
    mail_domain = str(config.get('mail_domain', '')).strip()
    if not is_valid_dns_name(mail_domain):
        raise ValueError('mail_domain must be a valid DNS name')

    for club in config.get('clubs', []):
        prefix = club.get('prefix', '')
        if not isinstance(prefix, str) or not TENANT_PREFIX_PATTERN.fullmatch(prefix):
            raise ValueError(f"invalid tenant prefix: {prefix!r}")
        domains = club.get('domains') or []
        if isinstance(domains, str):
            domains = [domains]
        if any(not is_valid_dns_name(domain) for domain in domains):
            raise ValueError(f"invalid tenant domain for {prefix}")
        if not is_safe_api_url(club.get('api_url', '')):
            raise ValueError(f"API URL for {prefix} must use HTTPS (or local HTTP)")


def parse_redirect_recipients(value):
    """Parse and validate the comma-separated development redirect list."""
    raw_recipients = (value or '').split(',')
    if any(not item.strip() for item in raw_recipients):
        return []
    recipients = [item.strip() for item in raw_recipients]
    if not recipients or any(not is_valid_email(item) for item in recipients):
        return []
    return sorted(set(recipients))


def fetch_club_lists(club, default_auth_token):
    """
    Fetch email lists from M2S API for a club.

    Uses the club's own auth_token if configured, otherwise falls back
    to the default auth_token for backward compatibility.

    Expected response format:
    {
        "lists": {
            "members": ["alice@gmail.com", "bob@yahoo.com", ...],
            "instructors": ["alice@gmail.com", ...],
            "towpilots": ["charlie@outlook.com", ...],
            "board": ["alice@gmail.com", "david@icloud.com", ...]
        },
        "whitelist": ["alice@gmail.com", "bob@yahoo.com", ...]
    }
    """
    try:
        if not is_safe_api_url(club.get('api_url', '')):
            raise ValueError('API URL must use HTTPS (or local HTTP)')
        # Use club-specific token if available, otherwise default
        auth_token = club.get('auth_token', default_auth_token)
        headers = {
            'X-API-Key': auth_token,
            'Accept': 'application/json',
        }
        response = requests.get(club['api_url'], headers=headers, timeout=30)
        response.raise_for_status()
        data = response.json()
        validate_club_response(data)
        return data
    except (requests.RequestException, ValueError) as e:
        print(f"[{datetime.now()}] ERROR: Failed to fetch lists for {club['prefix']}: {e}")
        return None


def generate_virtual_aliases(
    clubs_data, dev_mode=None, local_domains=None, bounce_email=None
):
    """Generate Postfix virtual alias file content.

    If dev_mode is enabled, ALL recipients are redirected to the configured
    dev_mode.redirect_to address. This prevents accidental emails to real
    users during development and testing.
    """
    # Check if dev mode is enabled
    dev_enabled = dev_mode and dev_mode.get('enabled', False)
    dev_redirect = dev_mode.get('redirect_to', '') if dev_mode else ''
    dev_redirects = parse_redirect_recipients(dev_redirect)
    if dev_enabled:
        # Keep this invariant inside the generator as well as in main(), so
        # callers cannot accidentally publish real bounce destinations.
        bounce_email = ','.join(dev_redirects)
    local_domains = {d.lower().rstrip('.') for d in (local_domains or [])}

    lines = [
        "# ============================================================",
        "# Virtual Aliases - Generated by m2s-sync-aliases.py",
        "# ============================================================",
        f"# Generated: {datetime.now().isoformat()}",
        "# DO NOT EDIT MANUALLY - will be overwritten by cron",
        "",
    ]

    if dev_enabled and dev_redirects:
        lines.append("# *** DEV MODE ENABLED ***")
        lines.append(f"# All mailing list recipients redirected to: {dev_redirect}")
        lines.append("# Set dev_mode.enabled: false in config for production!")
        lines.append("")

    for domain, data in clubs_data.items():
        if not data or 'lists' not in data:
            continue

        lines.append(f"# --- {domain} ---")

        for list_name, recipients in data['lists'].items():
            if not is_valid_alias_name(list_name):
                print(f"[{datetime.now()}] WARNING: Invalid mailing-list name for {domain}, skipping")
                continue
            if recipients:
                if dev_enabled:
                    # DEV MODE: Redirect all recipients to dev address
                    # Defense-in-depth: re-validate dev_redirect even though main() checked it
                    if not dev_redirects:
                        raise ValueError(f"Invalid dev_redirect email: {dev_redirect}")
                    # Include original recipient count in comment for visibility
                    # Sanitize preview recipients to prevent injection in comment
                    valid_recipients = sorted(set(r for r in recipients if is_valid_email(r)))
                    invalid_count = len(recipients) - len(valid_recipients)
                    preview_recipients = valid_recipients[:3]
                    preview = ','.join(preview_recipients)
                    valid_count = len(valid_recipients)
                    suffix = '...' if valid_count > 3 else ''
                    if invalid_count > 0:
                        lines.append(f"# WARNING: {invalid_count} invalid recipients filtered out")
                    lines.append(f"# Original recipients ({valid_count}): {preview}{suffix}")
                    lines.append(f"{list_name}@{domain}  {','.join(dev_redirects)}")
                    if bounce_email:
                        lines.append(f"{list_name}-bounces@{domain}  {bounce_email}")
                else:
                    # PRODUCTION: Normal recipients - sanitize to prevent injection
                    sanitized = [r for r in recipients if is_valid_email(r)]
                    if not sanitized:
                        # All recipients were filtered out - log warning
                        print(f"[{datetime.now()}] WARNING: {list_name}@{domain} - all {len(recipients)} recipients filtered (invalid emails)")
                        lines.append(f"# WARNING: {list_name}@{domain} - all recipients filtered (invalid emails)")
                    else:
                        recipients_str = ','.join(sorted(set(sanitized)))
                        lines.append(f"{list_name}@{domain}  {recipients_str}")
                        # Add Mailman-style -bounces alias (routes to admin, NOT to list members to avoid bounce storms)
                        if bounce_email:
                            lines.append(f"{list_name}-bounces@{domain}  {bounce_email}")

        lines.append("")

    # Direct forwarding addresses are not mailing lists. Keep their section
    # distinct so the header rewriter can distinguish them from list aliases.
    lines.append("# --- Administrative forwarding aliases ---")
    for domain, data in clubs_data.items():
        if not data:
            continue
        for name, destination in data.get('forwarding_aliases', {}).items():
            alias_address = f"{name}@{domain}"
            if not is_valid_alias_name(name) or not is_valid_email(destination):
                print(f"[{datetime.now()}] WARNING: Invalid forwarding alias for {domain}, skipping")
                continue
            recipients = dev_redirects if dev_enabled else [destination]
            invalid_destination = any(
                not is_valid_email(recipient)
                or recipient.lower() == alias_address.lower()
                or recipient.rsplit('@', 1)[-1].lower().rstrip('.') in local_domains
                for recipient in recipients
            )
            if invalid_destination:
                print(f"[{datetime.now()}] WARNING: Invalid forwarding destination for {alias_address}, skipping")
                continue
            lines.append(f"{alias_address}  {','.join(recipients)}")
            if bounce_email:
                lines.append(f"{name}-bounces@{domain}  {bounce_email}")

    return '\n'.join(lines)


def generate_postfix_whitelist(whitelist):
    """Generate one tenant-scoped Postfix sender whitelist."""
    lines = [
        "# ============================================================",
        "# Sender Whitelist - Generated by m2s-sync-aliases.py",
        "# ============================================================",
        f"# Generated: {datetime.now().isoformat()}",
        "# DO NOT EDIT MANUALLY - will be overwritten by cron",
        "",
    ]

    for sender in sorted(set(whitelist or [])):
        if not is_valid_email(sender):
            continue
        lines.append(f"{sender}  OK")

    return '\n'.join(lines)


def generate_per_club_rspamd_whitelist(club_prefix, whitelist):
    """Generate Rspamd sender whitelist map file content for a single club.

    Per-club whitelists provide tenant isolation - each club's whitelist
    only affects their own domain, preventing a malicious admin from
    whitelisting spammers that could affect other clubs.
    """
    lines = [
        "# ============================================================",
        f"# Rspamd Sender Whitelist for {club_prefix} - Generated by m2s-sync-aliases.py",
        "# ============================================================",
        f"# Generated: {datetime.now().isoformat()}",
        "# DO NOT EDIT MANUALLY - will be overwritten by cron",
        "#",
        "# Whitelisted senders bypass Rspamd spam checks only when SPF returns PASS.",
        "# (SPF PASS requirement prevents spoofing of whitelisted addresses)",
        "# Format: one email address per line",
        "",
    ]

    for sender in sorted(set(whitelist)):
        if is_valid_email(sender):
            lines.append(sender)

    return '\n'.join(lines)


def generate_rspamd_whitelist(clubs_data):
    """Generate Rspamd sender whitelist map file content."""
    lines = [
        "# ============================================================",
        "# Rspamd Sender Whitelist - Generated by m2s-sync-aliases.py",
        "# ============================================================",
        f"# Generated: {datetime.now().isoformat()}",
        "# DO NOT EDIT MANUALLY - will be overwritten by cron",
        "#",
        "# Whitelisted senders bypass Rspamd spam checks only when SPF returns PASS.",
        "# (SPF PASS requirement prevents spoofing of whitelisted addresses)",
        "# Format: one email address per line",
        "",
    ]

    all_senders = set()

    for domain, data in clubs_data.items():
        if data and 'whitelist' in data:
            all_senders.update(sender for sender in data['whitelist'] if is_valid_email(sender))

    for sender in sorted(all_senders):
        lines.append(sender)

    return '\n'.join(lines)


def generate_bypass_lists_map(clubs_bypass_lists):
    """Generate Rspamd bypass lists map file content.

    This file contains recipient patterns (e.g., treasurer@domain.com) for which
    whitelist enforcement is bypassed. These lists can receive mail from anyone
    (still requires SPF PASS, but no sender whitelist check).

    Format: One recipient email pattern per line.
    """
    lines = [
        "# ============================================================",
        "# Bypass Lists - Generated by m2s-sync-aliases.py",
        "# ============================================================",
        f"# Generated: {datetime.now().isoformat()}",
        "# DO NOT EDIT MANUALLY - will be overwritten by cron",
        "#",
        "# Recipients in this list bypass sender whitelist enforcement.",
        "# SPF PASS is still required (prevents spoofing), but any sender",
        "# can email these addresses (useful for service accounts).",
        "# Format: one recipient email per line (e.g., treasurer@domain.com)",
        "",
    ]

    for club_prefix, data in clubs_bypass_lists.items():
        domains = data['domains']
        bypass_lists = data.get('bypass_lists', [])
        if bypass_lists:
            lines.append(f"# {club_prefix} bypass lists")
            for list_name in bypass_lists:
                if not is_valid_alias_name(list_name):
                    print(f"[{datetime.now()}] WARNING: Invalid bypass-list name for {club_prefix}, skipping")
                    continue
                for domain in domains:
                    lines.append(
                        f"/^{re.escape(list_name)}(?:\\+[^@]+)?@{re.escape(domain)}$/i"
                    )

    return '\n'.join(lines)


def generate_protected_lists_map(clubs_data):
    """Generate the Rspamd map used to require SPF on every mailing list."""
    lines = [
        "# Protected mailing lists - generated by m2s-mail-sync.py",
        "# Public senders must pass SPF; authenticated submission is exempt.",
        "",
    ]
    for domain, data in clubs_data.items():
        if not data or 'lists' not in data:
            continue
        for list_name in data['lists']:
            recipient = f"{list_name}@{domain}"
            if is_valid_alias_name(list_name):
                lines.append(
                    f"/^{re.escape(list_name)}(?:\\+[^@]+)?@{re.escape(domain)}$/i"
                )
    return '\n'.join(lines)


def generate_recipient_whitelist_check(
    clubs_data, clubs_bypass_lists, clubs_whitelist_data
):
    """Generate Postfix recipient access restriction file (Issue #533).

    This file maps mailing list recipients to sender whitelist checks.
    Only lists with bypass_whitelist=false are included - those lists
    will REJECT mail from senders not in the whitelist.

    Lists with bypass_whitelist=true (in clubs_bypass_lists) are NOT
    included here, so they accept mail from anyone (for service accounts).

    Format: recipient_email  whitelist_required_<tenant>
    """
    lines = [
        "# ============================================================",
        "# Recipient Whitelist Check - Generated by m2s-sync-aliases.py",
        "# ============================================================",
        f"# Generated: {datetime.now().isoformat()}",
        "# DO NOT EDIT MANUALLY - will be overwritten by cron",
        "#",
        "# This file enforces sender whitelist for mailing lists.",
        "# Only lists with bypass_whitelist=false are included here.",
        "#",
        "# Format: recipient_email  whitelist_required_<tenant>",
        "#",
        "# Tenant-specific whitelist restriction classes are defined in main.cf as:",
        "#   whitelist_required_<tenant> = check_sender_access hash:<tenant-map>, reject",
        "#",
        "# If sender is in whitelist → OK (continue processing)",
        "# If sender is NOT in whitelist → REJECT (554 error)",
        "",
    ]

    # Resolve each served domain to the tenant-specific restriction class.
    domain_to_prefix = {
        domain.lower().rstrip('.'): prefix
        for prefix, data in clubs_whitelist_data.items()
        for domain in data.get('domains', [])
    }

    # Build set of bypass recipients (lists that accept from anyone)
    bypass_recipients = set()
    for club_prefix, data in clubs_bypass_lists.items():
        domains = data['domains']
        bypass_lists = data.get('bypass_lists', [])
        for list_name in bypass_lists:
            for domain in domains:
                bypass_recipients.add(f"{list_name}@{domain}")

    # Add recipient restrictions for non-bypass lists
    for domain, data in clubs_data.items():
        if not data or 'lists' not in data:
            continue

        lines.append(f"# --- {domain} ---")

        for list_name in data['lists'].keys():
            if not is_valid_alias_name(list_name):
                continue
            recipient = f"{list_name}@{domain}"

            # Skip bypass lists (they accept mail from anyone)
            if recipient in bypass_recipients:
                lines.append(f"# {recipient}  (bypass_whitelist=true, accepts from anyone)")
                continue

            # Enforce only the whitelist belonging to this recipient's tenant.
            prefix = domain_to_prefix.get(domain.lower().rstrip('.'))
            if prefix:
                lines.append(
                    f"{recipient}  {postfix_restriction_class(prefix)}"
                )
            else:
                # Unknown domain-to-tenant mappings fail closed.
                lines.append(f"{recipient}  reject")

        lines.append("")

    return '\n'.join(lines)


def file_changed(filepath, new_content):
    """Check if file content has changed using hash comparison."""
    if not os.path.exists(filepath):
        return True

    with open(filepath, 'r') as f:
        old_content = f.read()

    old_hash = hashlib.sha256(old_content.encode()).hexdigest()
    new_hash = hashlib.sha256(new_content.encode()).hexdigest()

    return old_hash != new_hash


def secure_postfix_map(filepath):
    """Restrict a Postfix map and its database to the Postfix group."""
    postfix_gid = grp.getgrnam('postfix').gr_gid
    for path in (filepath, f"{filepath}.db"):
        if os.path.exists(path):
            os.chown(path, 0, postfix_gid)
            os.chmod(path, 0o640)


def write_and_postmap(filepath, content):
    """Atomically publish a complete map and rebuild its Postfix database."""
    database_path = f"{filepath}.db"
    if not file_changed(filepath, content) and os.path.exists(database_path):
        secure_postfix_map(filepath)
        return False

    directory = os.path.dirname(filepath) or '.'
    fd, temp_path = tempfile.mkstemp(dir=directory)
    temp_database_path = f"{temp_path}.db"
    try:
        with os.fdopen(fd, 'w') as f:
            os.fchmod(f.fileno(), 0o644)
            f.write(content)

        # The rewriter runs as postfix and reads the virtual map through the
        # postfix group. Never expose member addresses to other local users.
        postfix_gid = grp.getgrnam('postfix').gr_gid
        os.chown(temp_path, 0, postfix_gid)
        os.chmod(temp_path, 0o640)

        # Build the database beside the temporary source. The rewriter takes
        # the same lock before reading the source map, so publishing the pair
        # under this lock cannot expose mixed generations to either reader.
        subprocess.run(['/usr/sbin/postmap', temp_path], check=True)
        if not os.path.exists(temp_database_path):
            raise RuntimeError(f'postmap did not create {temp_database_path}')
        os.chown(temp_database_path, 0, postfix_gid)
        os.chmod(temp_database_path, 0o640)
        lock_fd = None
        try:
            lock_fd = os.open(
                MAP_LOCK_FILE, os.O_RDWR
            )
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
        except OSError:
            if lock_fd is not None:
                os.close(lock_fd)
            raise

        database_backup = None
        try:
            if os.path.exists(database_path):
                backup_fd, database_backup = tempfile.mkstemp(dir=directory)
                os.close(backup_fd)
                os.unlink(database_backup)
                os.replace(database_path, database_backup)
            os.replace(temp_database_path, database_path)
            os.replace(temp_path, filepath)
        except Exception:
            if os.path.exists(database_path):
                os.unlink(database_path)
            if database_backup and os.path.exists(database_backup):
                os.replace(database_backup, database_path)
            raise
        finally:
            if database_backup and os.path.exists(database_backup):
                os.unlink(database_backup)
            if lock_fd is not None:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
                os.close(lock_fd)
    except Exception:
        for path in (temp_path, temp_database_path):
            if os.path.exists(path):
                os.unlink(path)
        raise

    secure_postfix_map(filepath)

    return True


def clear_virtual_aliases(config, reason):
    """Fail closed when dev-mode safety cannot be proven."""
    # Never allow diagnostic text to create additional Postfix map records.
    # In particular, a malformed redirect can contain newlines.
    safe_reason = ''.join(
        ' ' if ord(character) < 32 or ord(character) == 127 else character
        for character in str(reason)
    )
    content = (
        "# Virtual aliases disabled by m2s-mail-sync\n"
        f"# Reason: {safe_reason}\n"
        "# This file will be regenerated after configuration is corrected.\n"
    )
    write_and_postmap(config['postfix_virtual_file'], content)


def clear_authorization_maps(config, reason):
    """Remove stale authorization when no trusted API response is available."""
    safe_reason = ''.join(
        ' ' if ord(character) < 32 or ord(character) == 127 else character
        for character in str(reason)
    )
    empty_postfix_map = (
        "# Authorization maps disabled by m2s-mail-sync\n"
        f"# Reason: {safe_reason}\n"
    )
    for club in config.get('clubs', []):
        prefix = club.get('prefix')
        if prefix:
            path = os.path.join(
                config['postfix_whitelist_dir'], f"{prefix}_whitelist"
            )
            write_and_postmap(path, empty_postfix_map)
    write_and_postmap(config['postfix_recipient_check_file'], empty_postfix_map)
    rspamd_dir = config.get('rspamd_whitelist_dir')
    if rspamd_dir:
        for club in config.get('clubs', []):
            prefix = club.get('prefix')
            if prefix:
                write_rspamd_whitelist(
                    os.path.join(rspamd_dir, f"{prefix}_whitelist.map"),
                    empty_postfix_map,
                )
        write_rspamd_whitelist(
            os.path.join(rspamd_dir, 'bypass_lists.map'), empty_postfix_map
        )
        write_rspamd_whitelist(
            config.get(
                'rspamd_protected_lists_file',
                os.path.join(rspamd_dir, 'protected_lists.map'),
            ),
            empty_postfix_map,
        )


def write_rspamd_whitelist(filepath, content):
    """Write Rspamd whitelist file if content changed.

    Uses atomic write via temp file to prevent race conditions where
    Rspamd might read a partially-written file.
    """
    if not file_changed(filepath, content):
        try:
            rspamd_uid = pwd.getpwnam('_rspamd').pw_uid
            rspamd_gid = grp.getgrnam('_rspamd').gr_gid
            if os.path.exists(filepath):
                os.chown(filepath, rspamd_uid, rspamd_gid)
                os.chmod(filepath, 0o640)
        except KeyError:
            if os.path.exists(filepath):
                os.chmod(filepath, 0o640)
        return False

    temp_path = None
    try:
        # Verify directory exists
        dir_path = os.path.dirname(filepath)
        if not os.path.isdir(dir_path):
            print(f"[{datetime.now()}] ERROR: Rspamd whitelist directory does not exist: {dir_path}")
            return False

        # Write to temp file first, then atomic move
        fd, temp_path = tempfile.mkstemp(dir=dir_path)
        try:
            with os.fdopen(fd, 'w') as f:
                f.write(content)

            # Set ownership and permissions before moving
            try:
                rspamd_uid = pwd.getpwnam('_rspamd').pw_uid
                rspamd_gid = grp.getgrnam('_rspamd').gr_gid
                os.chown(temp_path, rspamd_uid, rspamd_gid)
                os.chmod(temp_path, 0o640)
            except KeyError:
                # _rspamd user doesn't exist (maybe on dev machine)
                os.chmod(temp_path, 0o640)

            # Atomic move
            shutil.move(temp_path, filepath)
        except Exception:
            # Clean up temp file on error
            if temp_path and os.path.exists(temp_path):
                os.unlink(temp_path)
            raise

        # Rspamd auto-reloads map files, no need to signal
        return True
    except (IOError, OSError) as e:
        print(f"[{datetime.now()}] ERROR: Failed to write Rspamd whitelist: {e}")
        return False


def ensure_rspamd_whitelist_dir(dir_path):
    """Ensure the Rspamd whitelist directory exists with correct permissions."""
    os.makedirs(dir_path, mode=0o750, exist_ok=True)
    os.chmod(dir_path, 0o750)
    try:
        rspamd_uid = pwd.getpwnam('_rspamd').pw_uid
        rspamd_gid = grp.getgrnam('_rspamd').gr_gid
        os.chown(dir_path, rspamd_uid, rspamd_gid)
    except KeyError:
        pass  # _rspamd user doesn't exist (dev machine)


def main():
    print(f"[{datetime.now()}] Starting M2S mail alias sync...")

    config = load_config()
    try:
        validate_configuration(config)
    except ValueError as exc:
        print(f"[{datetime.now()}] ERROR: Invalid mail-sync configuration: {exc}")
        clear_virtual_aliases(config, str(exc))
        clear_authorization_maps(config, str(exc))
        sys.exit(1)

    default_auth_token = config.get('default_auth_token', config.get('auth_token', ''))
    if not default_auth_token:
        # Check if ALL clubs have their own auth_token
        clubs = config.get('clubs', [])
        missing_tokens = [club['prefix'] for club in clubs if not club.get('auth_token')]
        if missing_tokens:
            reason = 'club API credentials missing'
            clear_virtual_aliases(config, reason)
            clear_authorization_maps(config, reason)
            print(f"[{datetime.now()}] ERROR: No default_auth_token and clubs missing auth_token: {', '.join(missing_tokens)}")
            sys.exit(1)

    # Validate the safety redirect before fetching data. If it is malformed,
    # clear the existing map instead of leaving real recipients active.
    dev_mode = config.get('dev_mode', {})
    if dev_mode.get('enabled', False):
        redirect_to = dev_mode.get('redirect_to', '').strip()
        if not redirect_to or not parse_redirect_recipients(redirect_to):
            reason = f"invalid dev_mode redirect_to email list: {redirect_to}"
            print(f"[{datetime.now()}] ERROR: {reason}")
            clear_virtual_aliases(config, reason)
            clear_authorization_maps(config, reason)
            sys.exit(1)
        dev_mode = {**dev_mode, 'redirect_to': redirect_to}
        print(f"[{datetime.now()}] *** DEV MODE ENABLED ***")
        print(f"[{datetime.now()}] All mailing list recipients will be redirected to: {redirect_to}")

    # Fetch lists from all clubs
    clubs_data = {}
    clubs_whitelist_data = {}  # Track per-club whitelist data
    clubs_bypass_lists = {}  # Track per-club bypass lists (Issue #492)
    for club in config['clubs']:
        data = fetch_club_lists(club, default_auth_token)
        if data:
            # Support both single 'domain' and multiple 'domains'
            # This provides backward compatibility with old configs
            domains = club.get('domains')
            if not domains:
                # Backward compatibility: fall back to single 'domain' key
                legacy_domain = club.get('domain')
                if not legacy_domain:
                    print(f"[{datetime.now()}] WARNING: Club {club['prefix']} has no domains configured")
                    continue
                domains = [legacy_domain]

            # Store data for each domain
            for domain in domains:
                clubs_data[domain] = data

            # Use first domain for whitelist tracking (all domains share same whitelist)
            clubs_whitelist_data[club['prefix']] = {
                'domains': domains,
                'whitelist': data.get('whitelist', [])
            }
            # Track bypass lists for this club
            bypass_lists = data.get('bypass_lists', [])
            if bypass_lists:
                clubs_bypass_lists[club['prefix']] = {
                    'domains': domains,
                    'bypass_lists': bypass_lists
                }
                print(f"[{datetime.now()}] Bypass lists for {club['prefix']}: {', '.join(bypass_lists)}")
            print(f"[{datetime.now()}] Fetched {len(data.get('lists', {}))} lists for {club['prefix']} ({len(domains)} domains)")

    if not clubs_data:
        reason = 'no club data fetched; disabling mail aliases until synchronization recovers'
        print(f"[{datetime.now()}] ERROR: {reason}")
        clear_virtual_aliases(config, reason)
        clear_authorization_maps(config, reason)
        sys.exit(0)

    # A partially unavailable tenant must not retain stale authorization.
    # Keep successful data, but publish empty maps for failed tenants below.
    configured_prefixes = {club['prefix'] for club in config.get('clubs', [])}
    for prefix in configured_prefixes - set(clubs_whitelist_data):
        club = next(
            club for club in config['clubs'] if club.get('prefix') == prefix
        )
        domains = club.get('domains') or []
        if isinstance(domains, str):
            domains = [domains]
        clubs_whitelist_data[prefix] = {'domains': domains, 'whitelist': []}

    # Check for dev mode (safety valve for development)
    dev_mode = config.get('dev_mode', {})
    if dev_mode.get('enabled', False):
        redirect_to = dev_mode.get('redirect_to', '').strip()
        redirect_addresses = [address.strip() for address in redirect_to.split(',')]
        if not redirect_to:
            print(f"[{datetime.now()}] ERROR: dev_mode enabled but no redirect_to address configured!")
            sys.exit(1)
        if any(not is_valid_email(address) for address in redirect_addresses):
            print(f"[{datetime.now()}] ERROR: Invalid dev_mode redirect_to email list: {redirect_to}")
            sys.exit(1)
        redirect_to = ','.join(redirect_addresses)
        dev_mode = {**dev_mode, 'redirect_to': redirect_to}
        print(f"[{datetime.now()}] *** DEV MODE ENABLED ***")
        print(f"[{datetime.now()}] All mailing list recipients will be redirected to: {redirect_to}")

    # Generate and update virtual aliases
    local_domains = set()
    mail_hostname = config.get('mail_hostname', '').strip().lower().rstrip('.')
    mail_domain = config.get('mail_domain', '').strip().lower().rstrip('.')
    local_domains.update(
        domain for domain in (
            mail_hostname,
            'localhost',
            f'localhost.{mail_domain}' if mail_domain else '',
        ) if domain
    )
    for club in config.get('clubs', []):
        explicit_domains = club.get('domains') or []
        if isinstance(explicit_domains, str):
            explicit_domains = [explicit_domains]
        if not club.get('use_explicit_domains_only', False):
            legacy_domain = club.get('domain') or f"{club['prefix']}.{config.get('mail_domain', '')}"
            if legacy_domain and not legacy_domain.endswith('.'):
                explicit_domains = [legacy_domain, *explicit_domains]
        local_domains.update(explicit_domains)
    bounce_email = config.get('admin_email', '').strip()
    if dev_mode.get('enabled', False):
        # Development mode must not leak even bounce notifications to a real
        # mailbox. Route all generated bounce aliases to the safe preview set.
        bounce_email = ','.join(parse_redirect_recipients(dev_mode.get('redirect_to', '')))
    has_forwards = any(
        data and data.get('forwarding_aliases')
        for data in clubs_data.values()
    )
    if not dev_mode.get('enabled', False) and bounce_email and (
        not is_valid_email(bounce_email)
        or bounce_email.rsplit('@', 1)[-1].lower().rstrip('.') in local_domains
    ):
        print(f"[{datetime.now()}] ERROR: admin_email must be a valid external monitored mailbox")
        bounce_email = ''
    if has_forwards and not bounce_email:
        # Do not install direct forwards whose delivery failures have nowhere
        # monitored to go. Mailing-list routes may still be synchronized.
        print(f"[{datetime.now()}] ERROR: skipping direct forwards without an external admin_email")
        for data in clubs_data.values():
            if data:
                data.pop('forwarding_aliases', None)
    virtual_content = generate_virtual_aliases(
        clubs_data,
        dev_mode=dev_mode,
        local_domains=local_domains,
        bounce_email=bounce_email,
    )
    if write_and_postmap(config['postfix_virtual_file'], virtual_content):
        print(f"[{datetime.now()}] Updated virtual aliases")
    else:
        print(f"[{datetime.now()}] Virtual aliases unchanged")

    # Generate and update tenant-scoped Postfix whitelists.
    for club_prefix, club_data in clubs_whitelist_data.items():
        whitelist_file = os.path.join(
            config['postfix_whitelist_dir'], f"{club_prefix}_whitelist"
        )
        whitelist_content = generate_postfix_whitelist(club_data['whitelist'])
        if write_and_postmap(whitelist_file, whitelist_content):
            print(f"[{datetime.now()}] Updated Postfix whitelist for {club_prefix}")
        else:
            print(f"[{datetime.now()}] Postfix whitelist unchanged for {club_prefix}")

    # Generate and update per-club Rspamd whitelists (if configured)
    if 'rspamd_whitelist_dir' in config:
        whitelist_dir = config['rspamd_whitelist_dir']
        ensure_rspamd_whitelist_dir(whitelist_dir)

        for club_prefix, club_data in clubs_whitelist_data.items():
            whitelist_file = os.path.join(whitelist_dir, f"{club_prefix}_whitelist.map")
            whitelist_content = generate_per_club_rspamd_whitelist(
                club_prefix, club_data['whitelist']
            )
            if write_rspamd_whitelist(whitelist_file, whitelist_content):
                print(f"[{datetime.now()}] Updated Rspamd whitelist for {club_prefix}")
            else:
                print(f"[{datetime.now()}] Rspamd whitelist unchanged for {club_prefix}")

    # Generate and update bypass lists map (Issue #492)
    # This lists recipients that bypass sender whitelist enforcement
    # Always write the file (even when empty) to clear stale data
    if 'rspamd_whitelist_dir' in config:
        bypass_file = os.path.join(config['rspamd_whitelist_dir'], "bypass_lists.map")
        bypass_content = generate_bypass_lists_map(clubs_bypass_lists)
        if write_rspamd_whitelist(bypass_file, bypass_content):
            print(f"[{datetime.now()}] Updated bypass lists map")
        else:
            print(f"[{datetime.now()}] Bypass lists map unchanged")

        protected_content = generate_protected_lists_map(clubs_data)
        if write_rspamd_whitelist(
            config['rspamd_protected_lists_file'], protected_content
        ):
            print(f"[{datetime.now()}] Updated protected-list SPF map")
        else:
            print(f"[{datetime.now()}] Protected-list SPF map unchanged")

    # Generate and update Postfix recipient whitelist check (Issue #533)
    # This enforces sender whitelist for mailing lists (reject if sender not whitelisted)
    if 'postfix_recipient_check_file' in config:
        recipient_check_content = generate_recipient_whitelist_check(
            clubs_data, clubs_bypass_lists, clubs_whitelist_data
        )
        if write_and_postmap(config['postfix_recipient_check_file'], recipient_check_content):
            print(f"[{datetime.now()}] Updated recipient whitelist check")
        else:
            print(f"[{datetime.now()}] Recipient whitelist check unchanged")

    print(f"[{datetime.now()}] Sync complete")


if __name__ == '__main__':
    main()
