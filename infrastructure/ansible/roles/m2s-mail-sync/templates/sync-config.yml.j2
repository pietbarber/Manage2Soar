# ============================================================
# M2S Mail Sync Configuration - Generated by Ansible
# ============================================================
# DO NOT EDIT MANUALLY - changes will be overwritten
# This file contains secrets - mode 0600

# Default authentication token for M2S API (used if club doesn't have its own)
# (Value is injected from Ansible Vault at deploy time, not hardcoded)
default_auth_token: "{{ m2s_api_key | default(vault_m2s_api_key | default('')) }}"

# Postfix configuration paths
postfix_virtual_file: "{{ postfix_config_dir }}/virtual"
postfix_whitelist_dir: "{{ postfix_whitelist_dir | default(postfix_config_dir ~ '/tenant-whitelists') }}"
postfix_recipient_check_file: "{{ postfix_config_dir }}/recipient_whitelist_check"
mail_domain: "{{ mail_domain | default(m2s_domain | default(''), true) }}"
mail_hostname: "{{ mail_hostname | default(m2s_domain | default(''), true) }}"
admin_email: "{{ admin_email | default('') }}"

# Rspamd whitelist directory (per-club whitelist files stored here)
rspamd_whitelist_dir: "/etc/rspamd/local.d/whitelists"
rspamd_protected_lists_file: "/etc/rspamd/local.d/whitelists/protected_lists.map"

# Development mode - redirect all mailing list recipients to configured addresses
# This prevents accidental emails during development/testing
dev_mode:
  enabled: {{ dev_mode_enabled | default(false) | lower }}
  redirect_to: "{{ dev_mode_redirect_to | default('', true) }}"

# Club configurations
# Each club can have its own auth_token for API isolation
clubs:
{% for club in club_domains %}
  - prefix: "{{ club.prefix }}"
    use_explicit_domains_only: {{ club.use_explicit_domains_only | default(false) | lower }}
{% set explicit_domains = club.domains | default([]) %}
{% if explicit_domains is string %}
{% set explicit_domains = [explicit_domains] %}
{% endif %}
{% set sync_domains = (explicit_domains if (club.use_explicit_domains_only | default(false)) and explicit_domains else [club.prefix ~ '.' ~ (mail_domain | default(m2s_domain | default(''), true))] + explicit_domains) | unique %}
    domains:
{% for domain in sync_domains %}
      - "{{ domain }}"
{% endfor %}
    api_url: "{{ club.api_url | default(m2s_site_url | default('https://' ~ (m2s_domain | default('localhost'))) ~ '/api/email-lists/') }}"
    auth_token: "{{ club.auth_token | default(m2s_api_key | default(vault_m2s_api_key | default(''))) }}"
{% endfor %}
