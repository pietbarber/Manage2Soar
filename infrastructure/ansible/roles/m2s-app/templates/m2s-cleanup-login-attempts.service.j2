# Systemd oneshot service that runs the django-axes cleanup management
# command (Issue #1110).  Mirrors the ``cleanup-login-attempts`` CronJob in
# ``k8s-cronjobs.yaml`` so single-host deployments enforce the same 24-hour
# retention window on ``axes_accessattempt``/``axes_accessfailurelog`` rows
# (previously only the K8s deployment scheduled the cleanup, so stale rows
# from one-off usernames/IPs accumulated indefinitely on single-host).
#
# Runs through the deployed ``manage.sh`` wrapper, which:
#   - sources ``{{ m2s_app_home }}/app/.env`` for the runtime environment
#     (``DJANGO_SETTINGS_MODULE``, DB credentials, etc.), and
#   - invokes the app's virtualenv Python against ``manage.py``.
#
# Executed as the unprivileged application user (``{{ m2s_app_user }}``), the
# same way the ``Run Django migrations`` / ``Collect static files`` tasks run
# in ``tasks/main.yml``.  BaseCronJobCommand's Postgres-backed distributed lock
# means concurrent runs (e.g. manual + timer) are serialized safely.
#
# Managed by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=Manage2Soar django-axes cleanup (issue #1110)
Documentation=man:cleanup_login_attempts
Wants=postgresql.service
After=network.target postgresql.service

[Service]
Type=oneshot
User={{ m2s_app_user }}
Group={{ m2s_app_group }}
WorkingDirectory={{ m2s_app_home }}/app
EnvironmentFile={{ m2s_app_home }}/app/.env
# ``manage.sh`` is owned by the app user (0755) and sources ``.env`` itself;
# the extra EnvironmentFile is harmless and matches the gunicorn.service
# convention so operators see the same environment shape.
ExecStart={{ m2s_app_home }}/manage.sh cleanup_login_attempts --verbosity=1
# Same 5-minute budget as the K8s CronJob's activeDeadlineSeconds.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
